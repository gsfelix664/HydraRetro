!emulators/duckstation/bios/.gitkeep
emulators/retroarch/system/**/*
!emulators/retroarch/system/
!emulators/retroarch/system/.gitkeep

# Ignorar saves, savestates, caches e logs de execução dos emuladores
media/**/*
!media/
!media/**/.gitkeep

