!ROMS/GBA/.gitkeep
!ROMS/GBC/
!ROMS/GBC/.gitkeep
!ROMS/GB/
!ROMS/GB/.gitkeep
!ROMS/SWITCH/
!ROMS/SWITCH/.gitkeep

BIOS/**/*
!BIOS/
!BIOS/.gitkeep
emulators/duckstation/bios/**/*
